# Copy this file to `.env` before running (`cp .env.example .env`). Never commit `.env`.
# Any omitted variable falls back to the preset for `LLM_PROVIDER` in src/compile_agent/config.py.
#
# Supported LLM_PROVIDER presets:
#   google | ollama | vllm | lmstudio | openai | openrouter | deepseek | openai_compatible

# ==============================================================================
# Option A: Google Gemini Developer API (default when LLM_PROVIDER=google)
# ==============================================================================
LLM_PROVIDER=google
# Supports single key OR comma-separated multi-key pool for automatic rotation on quota/429:
# GOOGLE_API_KEY=AIzaKey1,AIzaKey2,AIzaKey3
GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MASTER_MODEL=gemini-2.5-flash
# DISCUSSION_MODELS=gemini-2.5-flash

# ==============================================================================
# Option B: Local / Self-Hosted
# ==============================================================================
# --- Ollama example (http://localhost:11434/v1) ---
# LLM_PROVIDER=ollama
# MASTER_MODEL=qwen3:30b
# DISCUSSION_MODELS=qwen3:30b
# LLM_CONTEXT_WINDOW=16384
# LLM_THINKING=false
#
# --- vLLM / SGLang example (http://localhost:8000/v1) ---
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# MASTER_MODEL=Qwen/Qwen3-30B-A3B
# DISCUSSION_MODELS=Qwen/Qwen3-30B-A3B
#
# --- LM Studio example (http://localhost:1234/v1) ---
# LLM_PROVIDER=lmstudio
# MASTER_MODEL=qwen/qwen3-30b-a3b
#
# --- Custom OpenAI-compatible server / OpenRouter / DeepSeek ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEYS=key1,key2
# MASTER_MODEL=qwen3-30b

# Optional unified overrides (take precedence over provider presets)
# LLM_BASE_URL=
# LLM_API_KEYS=
# LLM_API_KEY=
# MASTER_MODEL=
# DISCUSSION_MODELS=

# ==============================================================================
# Shared Runtime, Context & Reliability Settings
# ==============================================================================
LLM_TEMPERATURE=0.1
# Leave LLM_TIMEOUT empty to use the preset default (60s cloud / 180s local)
# LLM_TIMEOUT=60
# Ollama defaults to LLM_CONTEXT_WINDOW=16384 if unset
# LLM_CONTEXT_WINDOW=16384
# Optional max completion tokens per step
# LLM_MAX_TOKENS=
# Reasoning control: auto | true | false (auto disables Qwen3 thinking on local ReAct for speed)
LLM_THINKING=auto
# ErrorSolver mode: auto | fast | debate (auto uses fast 2-agent mode for single local GPU model)
ERROR_SOLVER_MODE=auto
# Abort batch after N consecutive repo/LLM connectivity failures or failed health probe
LLM_CIRCUIT_BREAKER_THRESHOLD=3
NAVIGATOR_MAX_ITERATIONS=10
MAKE_JOBS=4
USE_PROXY=false
# PROXY=
PASSWORD=root

# Optional legacy / fallback API keys (also support comma-separated key pools)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
