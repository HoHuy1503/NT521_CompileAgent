# Copy this file to `.env` before running (`cp .env.example .env`). Never commit `.env`.
# Any omitted variable falls back to the preset for `LLM_PROVIDER` in Config.py.
#
# Supported LLM_PROVIDER presets:
#   google | ollama | vllm | lmstudio | openai | openrouter | deepseek | openai_compatible

# ==============================================================================
# Option A: Google Gemini Developer API (default when LLM_PROVIDER=google)
# ==============================================================================
LLM_PROVIDER=google
GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MASTER_MODEL=gemini-3.5-flash-lite
# DISCUSSION_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview

# ==============================================================================
# Option B: Local / Self-Hosted Qwen3 30B or Any OpenAI-Compatible Endpoint
# ==============================================================================
# --- Ollama example (http://localhost:11434/v1) ---
# LLM_PROVIDER=ollama
# MASTER_MODEL=qwen3:30b
# DISCUSSION_MODELS=qwen3:30b
#
# --- vLLM / SGLang example (http://localhost:8000/v1) ---
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# MASTER_MODEL=Qwen/Qwen3-30B-A3B
# DISCUSSION_MODELS=Qwen/Qwen3-30B-A3B
#
# --- LM Studio example (http://localhost:1234/v1) ---
# LLM_PROVIDER=lmstudio
# MASTER_MODEL=qwen/qwen3-30b-a3b
#
# --- Custom OpenAI-compatible server / OpenRouter / Bailian / DeepSeek ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=
# MASTER_MODEL=qwen3-30b

# Optional unified overrides (take precedence over provider presets)
# LLM_BASE_URL=
# LLM_API_KEY=
# MASTER_MODEL=
# DISCUSSION_MODELS=

# ==============================================================================
# Shared Runtime Settings
# ==============================================================================
LLM_TEMPERATURE=0.1
# Leave LLM_TIMEOUT empty to use the preset default (60s cloud / 180s local)
# LLM_TIMEOUT=60
MAKE_JOBS=4
USE_PROXY=false
# PROXY=
PASSWORD=root

# Optional legacy / fallback API keys
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
