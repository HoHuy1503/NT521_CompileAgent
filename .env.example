# Copy this file to `.env` before running (`cp .env.example .env`). Never commit `.env`.
# This project runs purely on Local LLMs (no Cloud API keys required).
#
# Supported Local LLM_PROVIDER presets:
#   llamacpp | ollama | vllm | lmstudio | openai_compatible

# ==============================================================================
# Default: llama.cpp / llama-server with Vulkan SDK (http://localhost:8080/v1)
# Recommended server launch for Qwen 3.8 K_M Q4 27B:
#   llama-server -m <path_to_qwen3.8_27b_q4_k_m.gguf> -ngl 99 --port 8080 --jinja --reasoning off -c 16384
# ==============================================================================
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://localhost:8080/v1
MASTER_MODEL=Qwen 3.8 K_M Q4 27B
# 3-agent ErrorSolver models (single model uses 3 temperatures [0.1, 0.4, 0.7], or specify 3 comma-separated local models)
DISCUSSION_MODELS=Qwen 3.8 K_M Q4 27B
# Optional local embedding model if Chroma RAG is used
OPENAI_EMBEDDING_MODEL=

# ==============================================================================
# Alternative Local Backends (uncomment to switch)
# ==============================================================================
# --- Ollama (http://localhost:11434/v1) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# MASTER_MODEL=qwen3:30b
# DISCUSSION_MODELS=qwen3:30b
#
# --- vLLM / SGLang (http://localhost:8000/v1) ---
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://localhost:8000/v1
# MASTER_MODEL=Qwen/Qwen3-30B-A3B
# DISCUSSION_MODELS=Qwen/Qwen3-30B-A3B
#
# --- LM Studio (http://localhost:1234/v1) ---
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# MASTER_MODEL=qwen/qwen3-30b-a3b
# DISCUSSION_MODELS=qwen/qwen3-30b-a3b

# ==============================================================================
# Runtime, Context & Reliability Settings
# ==============================================================================
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=240
LLM_CONTEXT_WINDOW=16384
# Optional max completion tokens per step
# LLM_MAX_TOKENS=
# Reasoning control: auto | true | false (auto disables thinking on local thinking models & llamacpp)
LLM_THINKING=false
LLM_CIRCUIT_BREAKER_THRESHOLD=3
NAVIGATOR_MAX_ITERATIONS=15
SHELL_STUCK_TIMEOUT=240
MAKE_JOBS=4
USE_PROXY=false
PROXY=
PASSWORD=root
